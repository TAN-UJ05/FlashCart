# ============================================================
# FlashCart Environment Variables Example
# Copy to .env for local Docker Compose (never commit .env)
# ============================================================

# JWT Configuration (min 32 characters; generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-cryptographically-random-64-char-hex-secret-key
FLASHCART_JWT_SECRET=${JWT_SECRET}

# PostgreSQL (used by docker-compose.yml locally)
POSTGRES_DB=flashcart
POSTGRES_USER=flashcart
POSTGRES_PASSWORD=replace-with-strong-db-password

# Production Spring Boot Overrides (used when SPRING_PROFILES_ACTIVE=prod)
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flashcart
SPRING_DATASOURCE_USERNAME=flashcart
SPRING_DATASOURCE_PASSWORD=replace-with-strong-db-password
DB_POOL_MAX=30
DB_POOL_MIN_IDLE=5

# Redis (Upstash requires REDIS_SSL=true and REDIS_PASSWORD)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Kafka (set KAFKA_ENABLED=false for zero-Kafka free-tier cloud demos)
KAFKA_ENABLED=true
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security, Cookies & CORS
FRONTEND_URL=http://localhost:3000
FLASHCART_COOKIE_SECURE=false
FLASHCART_TRUST_PROXY=false

# Observability & Docs
SWAGGER_ENABLED=true
HEALTH_SHOW_DETAILS=when_authorized
LOG_LEVEL=INFO
